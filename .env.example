SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_MCP_CONFIG_ID=
# Optional if the GET config response already includes mcp_server_url
SCALEKIT_MCP_SERVER_URL=
GITHUB_CONNECTION_NAME=github-connect
DEMO_IDENTIFIER=demo-user

RUNLOOP_API_KEY=

# Use LiteLLM (preferred if you already have a gateway) OR a native Anthropic key.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Must match a model your LiteLLM key can call
CLAUDE_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

PORT=3456
